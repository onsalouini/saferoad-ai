# Copier en api/.env puis adapter

# --- Base de données ---
# MongoDB (optionnel) : sans cette variable, un fichier JSON local est utilisé
MONGO_URI=
MONGO_DB=saferoad

# --- Sécurité ---
# Secret de signature des jetons de connexion (obligatoire en production, 32 caractères ou plus)
JWT_SECRET=change-me
# Origines autorisées pour le frontend (les cookies de session exigent des origines explicites)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Adresse du frontend (liens dans les e-mails)
FRONTEND_URL=http://localhost:5173
# Cookie de session : COOKIE_SECURE=true en HTTPS ; COOKIE_SAMESITE=none si le frontend est sur un autre domaine
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Copilote IA (optionnel) ---
# Fournisseur : "groq" (gratuit avec limites, https://console.groq.com) ou "anthropic" (Claude)
ASSISTANT_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Clé Claude API (https://console.anthropic.com). Sans clé, le copilote est désactivé.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_RATE_LIMIT=30

# --- E-mails (optionnel) ---
# Sans SMTP_HOST, les e-mails (réinitialisation, alertes) sont affichés dans la console du serveur
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SafeRoad AI <no-reply@example.com>
SMTP_SSL=false

# --- Modèle ---
# URL de téléchargement si ml/models/saferoad_model.pkl est absent (déploiement)
# MODEL_URL=

# --- Notifications push (Web Push / VAPID) ---
# Clé générée au premier démarrage si absente (à conserver : la changer invalide les abonnements)
# VAPID_PRIVATE_KEY_FILE=data/vapid_private.pem
VAPID_CONTACT=mailto:admin@example.com

# --- Trafic en temps réel (optionnel) ---
# Clé gratuite : https://developer.tomtom.com (incidents sur l'itinéraire)
TOMTOM_API_KEY=

# --- Plusieurs instances de l'API (optionnel) ---
# Redis partage les limites de débit et le verrou du planificateur d'alertes
REDIS_URL=

# --- Suivi des erreurs (optionnel) ---
SENTRY_DSN=
ENVIRONMENT=development

# --- Alertes de départ ---
SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_S=300
# ALERT_LEAD_MIN=60

# --- Services cartographiques (instances publiques par défaut ; auto-héberger en production) ---
# OSRM_URL=https://router.project-osrm.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_MIN_INTERVAL_S=1.0
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_RADIUS_M=150
# OVERPASS_TIMEOUT_S=12
# DISK_CACHE_PATH=data/cache.sqlite
# HTTP_USER_AGENT=SafeRoadAI/3.0 (contact@example.com)
