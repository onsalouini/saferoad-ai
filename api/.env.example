# Copier en api/.env puis adapter
# MongoDB (optionnel) : sans cette variable, un fichier JSON local est utilisé
MONGO_URI=
MONGO_DB=saferoad
# Secret de signature des jetons de connexion (obligatoire en production)
JWT_SECRET=change-me
# Origines autorisées pour le frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
